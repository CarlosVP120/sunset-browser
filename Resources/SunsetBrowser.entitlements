<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Llaves de acceso (passkeys) con Touch ID en cualquier sitio. Apple solo la concede a
         navegadores aprobados; hace falta pedirla con la cuenta de desarrollador (Account Holder). -->
    <key>com.apple.developer.web-browser.public-key-credential</key>
    <true/>
</dict>
</plist>
